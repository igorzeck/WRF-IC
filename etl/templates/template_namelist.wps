&share
    interval_seconds = 10800
    io_form_geogrid = 2
    max_dom = 4
    start_date = '_wps_data_inicial_', '_wps_data_inicial_', '_wps_data_inicial_', '_wps_data_inicial_'
    end_date   = '_wps_data_final_', '_wps_data_final_', '_wps_data_final_', '_wps_data_final_'
    wrf_core = 'ARW'
/

&geogrid
    parent_id         =   1,   1,   2,   3
    parent_grid_ratio =   1,   3,   3,   3
    i_parent_start    =   1,  14,  24,  24
    j_parent_start    =   1,  14,  24,  24
    e_we              =  50,  70,  70,  70
    e_sn              =  50,  70,  70,  70
    geog_data_res     = 'default', 'default', 'default', 'default'
    dx = 27000
    dy = 27000
    map_proj = 'mercator'
    ref_lat   = -22.804943908755842
    ref_lon   = -43.256455001858306
    truelat1  = -22.804943908755842
    stand_lon = -43.256455001858306
    geog_data_path = '/home/rf/WD/Build_WRF/WPS_GEOG'
/

&ungrib
    out_format = 'WPS'
    prefix = 'FILE'
/

&metgrid
    fg_name = 'FILE'
    io_form_metgrid = 2
/
